// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deposit {
  id          Int      @id @default(autoincrement())
  amount      Decimal
  depositDate DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@map("deposits")
}

model Stock {
  id               Int                   @id @default(autoincrement())
  symbol           String                @unique
  companyName      String?
  sector           String?
  createdAt        DateTime              @default(now())
  buyTransactions  StockBuyTransaction[]
  sellTransactions StockSellTransaction[]
  dividends        Dividend[]
  currentPrice     StockPrice?

  @@map("stocks")
}

model StockBuyTransaction {
  id        Int      @id @default(autoincrement())
  stockId   Int
  quantity  Int
  buyRate   Decimal
  totalCost Decimal
  buyDate   DateTime
  notes     String?
  createdAt DateTime @default(now())
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_buy_transactions")
}

model StockSellTransaction {
  id               Int      @id @default(autoincrement())
  stockId          Int
  quantity         Int
  sellRate         Decimal
  totalProceeds    Decimal
  realizedGainLoss Decimal
  sellDate         DateTime
  notes            String?
  createdAt        DateTime @default(now())
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_sell_transactions")
}

model Dividend {
  id             Int      @id @default(autoincrement())
  stockId        Int
  dividendAmount Decimal
  dividendDate   DateTime
  notes          String?
  createdAt      DateTime @default(now())
  stock          Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("dividends")
}

model StockPrice {
  id           Int      @id @default(autoincrement())
  stockId      Int      @unique
  currentPrice Decimal
  updatedAt    DateTime @updatedAt
  stock        Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_prices")
}