{
  "name": "portfolio-tracker",
  "version": "1.0.8",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist && rm -rf dist-electron",
    "electron:dev": "concurrently \"pnpm dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "pnpm clean && pnpm build && electron-builder",
    "electron:build:mac": "pnpm clean && pnpm build && electron-builder --mac",
    "electron:build:win": "pnpm clean && pnpm build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.raheel.psit",
    "productName": "Portfolio Tracker",
    "directories": {
      "output": "dist-electron"
    },
    "icon": "public/icon.png",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!.env",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null,
      "asar": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "ace-builds": "^1.44.0",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.5.0",
    "lucide-react": "^0.562.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-ace": "^15.0.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase-admin": "^14.0.0",
    "globals": "^17.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.3.0",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^9.0.3"
  }
}
